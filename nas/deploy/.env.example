# 复制为 .env 后按需修改：cp .env.example .env
# docker compose 会自动读取同目录的 .env

# 宿主机映射端口（浏览器访问 http://<主机IP>:<PORT>）
PORT=8090

# 镜像 tag（便于回滚：改成之前构建过的 tag 再 up -d）
IMAGE_TAG=latest

# 日志级别：fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# 时区（容器内日志时间）
TZ=Asia/Shanghai

# npm 源：国内默认 npmmirror；海外可改 https://registry.npmjs.org
NPM_REGISTRY=https://registry.npmmirror.com

# 构建用基础镜像。NAS 上若没有 node:20-alpine（常见，飞牛自带的可能是 22），
# 改成实际存在的版本即可，无需修改 Dockerfile：
# NODE_IMAGE=node:22-alpine

# --- 安全相关 ---------------------------------------------------------------
# 加密托管 cookie 的主密钥（32 字节 hex）。留空则首次启动自动生成并存入
# ./data/.masterkey；迁移机器时把它一起带走，否则已托管登录态无法解密。
# 生成示例：openssl rand -hex 32
NAS_MASTER_KEY=

# 公网 / 云服务器部署务必设置：WebUI 首次访问会弹窗录入该令牌，
# 之后 REST 走 x-api-token 头、WS 走 ?token= 参数。
# 局域网（NAS / 家里）可以留空。
# 生成示例：openssl rand -hex 24
PURE_LIVE_TOKEN=

# --- 可选：环境变量注入平台登录态（省去在 WebUI 里粘贴）--------------------
# 键名规则：PURE_LIVE_COOKIE_<平台大写>，值为浏览器里整份 Cookie
# PURE_LIVE_COOKIE_BILIBILI=SESSDATA=xxx;bili_jct=xxx;DedeUserID=xxx
# PURE_LIVE_COOKIE_DOUYU=acf_uid=xxx;acf_stk=xxx;acf_ltkid=xxx;dy_did=xxx
# PURE_LIVE_COOKIE_HUYA=yyuid=xxx;udb_uid=xxx
